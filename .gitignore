# Next.js
node_modules/
.next/
out/
*.tsbuildinfo

# Env
.env*.local

# OS
.DS_Store

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Images / video / data — never commit large binaries
*.jpg
*.jpeg
*.png
*.gif
*.webp
*.mp4
*.mov
*.pdb
*.cif

# Exception: compressed gallery photos used by PhotoGallery (about 1.3MB total)
!public/images/gallery/
!public/images/gallery/*.jpg

# Exception: corona cryo-EM 2D class tiles used by CoronaClasses
!public/images/corona/*.png
!public/images/corona/*.jpg
!public/images/corona/*.mp4

# Exception: pre-rendered Manim ML visualization used by SimulatedPredictor
!public/videos/ml-viz/
!public/videos/ml-viz/*.mp4
!public/videos/ml-viz/*.jpg
.taste-skill/
